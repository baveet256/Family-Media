# =============================================================================
# Family Media — monorepo .gitignore
# =============================================================================

# --- Dependencies ---
node_modules/
**/node_modules/
.pnp
.pnp.js

# --- Environment (never commit secrets) ---
.env
.env.*
!.env.example
!**/.env.example

# --- Build outputs ---
dist/
**/dist/
build/
**/build/
out/
.next/
.nuxt/
*.tsbuildinfo

# --- API (NestJS) ---
api/dist/
api/coverage/
api/.env
api/.env.*
!api/.env.example

# --- Mobile (Expo / React Native) ---
mobile/.expo/
mobile/.expo-shared/
mobile/web-build/
mobile/expo-env.d.ts
mobile/.env
mobile/.env.*
!mobile/.env.example

# Expo prebuild / native projects (regenerated)
mobile/ios/
mobile/android/
mobile/.kotlin/

# --- Prisma ---
api/prisma/*.db
api/prisma/*.db-journal

# --- Docker (local volume mounts, if any) ---
docker-data/
*.pid

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing ---
coverage/
**/coverage/
.nyc_output/
junit.xml

# --- Caches ---
.cache/
.turbo/
.eslintcache
.parcel-cache/
.metro-health-check*
**/.metro-health-check*

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDEs & editors ---
.idea/
*.iml
*.swp
*.swo
*~

# VS Code — ignore workspace settings, keep shared recommendations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json

# Cursor
.cursor/

# --- AI / local tooling (generated by templates, not app source) ---
.claude/
**/.claude/
AGENTS.md
CLAUDE.md

# --- Secrets & signing ---
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
google-services.json
GoogleService-Info.plist

# --- Misc ---
*.local
.vercel
.netlify
