# ---- Local development defaults ----
# Copy to .env. Never reuse these values in production.

DATABASE_URL=postgresql://familymedia:familymedia@localhost:5432/familymedia
REDIS_URL=redis://localhost:6379
PORT=3000

# Set to "production" in deployed environments. This turns on strict config
# validation, hides error details, and disables all dev affordances.
NODE_ENV=development

# REQUIRED. Generate a unique value per environment:
#   openssl rand -base64 48
# Production boot fails if this is missing, shorter than 32 chars, or left as
# the example value below.
JWT_SECRET=dev-family-media-jwt-secret-change-me
JWT_EXPIRES_IN=30d

# Returns the OTP code in the API response for local testing.
# Ignored when NODE_ENV=production, and boot fails if set to true there.
OTP_DEV_MODE=true

# Comma-separated browser origins. Leave empty in production unless a web
# client exists; the mobile app does not send an Origin header.
CORS_ALLOWED_ORIGINS=

# Base URL used to build public media URLs. Must be https:// in production.
PUBLIC_API_URL=http://localhost:3000
