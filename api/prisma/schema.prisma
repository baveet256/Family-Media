generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  admin
  member
}

enum MembershipStatus {
  pending
  active
  removed
}

enum JoinRequestStatus {
  pending
  approved
  rejected
}

enum RelationshipType {
  parent_of
  spouse_of
  sibling_of
}

enum RelationshipSource {
  onboarding
  admin
  inferred
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  phone       String   @unique
  displayName String   @default("") @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships  FamilyMembership[]
  joinRequests JoinRequest[]
  persons      Person[]
  posts        Post[]
  reactions    PostReaction[]
  comments     PostComment[]
  stories      Story[]
  storyViews   StoryView[]

  @@map("users")
}

model Family {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  avatarUrl  String?  @map("avatar_url")
  inviteCode String   @unique @map("invite_code")
  settings   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships   FamilyMembership[]
  joinRequests  JoinRequest[]
  persons       Person[]
  relationships Relationship[]
  posts         Post[]
  stories       Story[]

  @@map("families")
}

model FamilyMembership {
  id       String           @id @default(uuid()) @db.Uuid
  familyId String           @map("family_id") @db.Uuid
  userId   String           @map("user_id") @db.Uuid
  role     MembershipRole
  status   MembershipStatus @default(pending)
  joinedAt DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_memberships")
}

model JoinRequest {
  id         String            @id @default(uuid()) @db.Uuid
  familyId   String            @map("family_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  status     JoinRequestStatus @default(pending)
  inviteCode String?           @map("invite_code")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingAnswers OnboardingAnswer[]

  @@index([familyId, status])
  @@index([userId])
  @@map("join_requests")
}

model Person {
  id            String    @id @default(uuid()) @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  displayName   String    @map("display_name")
  phone         String?
  birthDate     DateTime? @map("birth_date") @db.Date
  deathDate     DateTime? @map("death_date") @db.Date
  gender        String?
  avatarUrl     String?   @map("avatar_url")
  isPlaceholder Boolean   @default(false) @map("is_placeholder")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  family           Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  relationshipsFrom Relationship[] @relation("RelationshipFrom")
  relationshipsTo   Relationship[] @relation("RelationshipTo")

  @@index([familyId])
  @@index([userId])
  @@map("persons")
}

model Relationship {
  id           String             @id @default(uuid()) @db.Uuid
  familyId     String             @map("family_id") @db.Uuid
  fromPersonId String             @map("from_person_id") @db.Uuid
  toPersonId   String             @map("to_person_id") @db.Uuid
  type         RelationshipType
  source       RelationshipSource @default(onboarding)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  family     Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromPerson Person @relation("RelationshipFrom", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson   Person @relation("RelationshipTo", fields: [toPersonId], references: [id], onDelete: Cascade)

  @@unique([familyId, fromPersonId, toPersonId, type])
  @@index([familyId, type])
  @@map("relationships")
}

model OnboardingAnswer {
  id            String   @id @default(uuid()) @db.Uuid
  joinRequestId String   @map("join_request_id") @db.Uuid
  questionKey   String   @map("question_key")
  answerJson    Json     @map("answer_json")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  joinRequest JoinRequest @relation(fields: [joinRequestId], references: [id], onDelete: Cascade)

  @@unique([joinRequestId, questionKey])
  @@index([joinRequestId])
  @@map("onboarding_answers")
}

enum PostVisibility {
  family
  connection
}

enum MediaType {
  image
  video
}

model Post {
  id           String         @id @default(uuid()) @db.Uuid
  familyId     String         @map("family_id") @db.Uuid
  authorUserId String         @map("author_user_id") @db.Uuid
  caption      String?        @db.Text
  visibility   PostVisibility @default(family)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  family    Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  media     PostMedia[]
  reactions PostReaction[]
  comments  PostComment[]

  @@index([familyId, createdAt(sort: Desc)])
  @@index([authorUserId])
  @@map("posts")
}

model PostMedia {
  id           String    @id @default(uuid()) @db.Uuid
  postId       String    @map("post_id") @db.Uuid
  mediaType    MediaType @map("media_type")
  url          String
  thumbnailUrl String?   @map("thumbnail_url")
  sortOrder    Int       @default(0) @map("sort_order")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model PostReaction {
  postId String @map("post_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  emoji  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_reactions")
}

model PostComment {
  id           String   @id @default(uuid()) @db.Uuid
  postId       String   @map("post_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("post_comments")
}

model Story {
  id           String    @id @default(uuid()) @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  authorUserId String    @map("author_user_id") @db.Uuid
  mediaType    MediaType @map("media_type")
  url          String
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  family  Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author  User        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  views   StoryView[]

  @@index([familyId, expiresAt])
  @@index([authorUserId, createdAt(sort: Desc)])
  @@map("stories")
}

model StoryView {
  storyId      String   @map("story_id") @db.Uuid
  viewerUserId String   @map("viewer_user_id") @db.Uuid
  viewedAt     DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerUserId])
  @@map("story_views")
}
