generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  admin
  member
}

enum MembershipStatus {
  pending
  active
  removed
}

enum JoinRequestStatus {
  pending
  approved
  rejected
}

/// App account — authenticated by phone + OTP
model User {
  id          String   @id @default(uuid()) @db.Uuid
  phone       String   @unique
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships  FamilyMembership[]
  joinRequests JoinRequest[]

  @@map("users")
}

/// Isolated family unit
model Family {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  avatarUrl  String?  @map("avatar_url")
  inviteCode String   @unique @map("invite_code")
  /// { requireApproval: boolean, whoCanInvite: "admin" | "member" }
  settings   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  memberships  FamilyMembership[]
  joinRequests JoinRequest[]

  @@map("families")
}

/// User <-> Family with role
model FamilyMembership {
  id       String           @id @default(uuid()) @db.Uuid
  familyId String           @map("family_id") @db.Uuid
  userId   String           @map("user_id") @db.Uuid
  role     MembershipRole   @default(member)
  status   MembershipStatus @default(pending)
  joinedAt DateTime?        @map("joined_at") @db.Timestamptz
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_memberships")
}

/// QR / invite-code join flow
model JoinRequest {
  id         String            @id @default(uuid()) @db.Uuid
  familyId   String            @map("family_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  status     JoinRequestStatus @default(pending)
  inviteCode String?           @map("invite_code")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, status])
  @@index([userId])
  @@map("join_requests")
}
